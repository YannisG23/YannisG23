# Copie ce fichier en « .env » et remplis-le.

# Clé d'API Anthropic : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Toi
JARVIS_USER_NAME=Yannis
JARVIS_CITY=Paris
JARVIS_COUNTRY=FR
JARVIS_LANGUAGE=fr

# Cerveau : modèle Claude et niveau de réflexion (low = plus rapide, high = plus réfléchi)
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=medium

# Voix naturelle : liste avec « edge-tts --list-voices »
# (ex. fr-FR-RemyMultilingualNeural, fr-FR-VivienneMultilingualNeural, fr-FR-HenriNeural)
JARVIS_VOICE=fr-FR-RemyMultilingualNeural
JARVIS_VOICE_RATE=+5%

# Reconnaissance vocale Whisper : tiny, base, small, medium, large-v3 (plus gros = plus précis mais plus lent)
JARVIS_WHISPER_MODEL=small
# Sensibilité du mot d'activation « Hey Jarvis » (0 à 1, plus bas = plus sensible)
JARVIS_WAKE_THRESHOLD=0.5
# Secondes pendant lesquelles Jarvis attend une suite sans redire « Hey Jarvis »
JARVIS_FOLLOW_UP_SECONDS=6

# Mémoire : minutes d'inactivité avant de résumer la conversation dans la mémoire
JARVIS_IDLE_MINUTES=20

# Rappels de rendez-vous (minutes d'avance, 0 = désactivé) et port du centre de commande
JARVIS_EVENT_REMINDER_MINUTES=10
JARVIS_DASHBOARD_PORT=8765
