# Copie ce fichier en « .env » et remplis-le.

# Cerveau :
#   abonnement = ton compte Claude Pro/Max via Claude Code (prix fixe, pas de facture à l'usage)
#                → connecte-le une fois avec : python -m jarvis --login
#   api        = clé API Anthropic, facturée à l'usage (remplis ANTHROPIC_API_KEY)
JARVIS_BRAIN=abonnement
ANTHROPIC_API_KEY=

# Son nom : c'est aussi le mot qui le réveille. Au premier lancement, il le choisit lui-même et te
# demande de valider ; tu peux aussi lui dire « à partir de maintenant tu t'appelles Kali ».
# Pour imposer un nom dès le départ, retire le # ci-dessous.
# JARVIS_NAME=Jarvis
# Autres orthographes que la reconnaissance vocale pourrait écrire, séparées par des virgules.
JARVIS_NAME_ALIASES=

# Toi
JARVIS_USER_NAME=Yannis
JARVIS_CITY=Paris
JARVIS_COUNTRY=FR
JARVIS_LANGUAGE=fr

# Modèle Claude : vide = Sonnet, rapide et malin, idéal à la voix. « opus » = le plus puissant, plus lent.
# (En mode api, vide = claude-opus-5.)
JARVIS_MODEL=
# Niveau de réflexion : low = réponses rapides (conseillé à la voix), medium, high = plus réfléchi
JARVIS_EFFORT=low
# Délégation à Codex (abonnement ChatGPT) : off, auto ou max
JARVIS_CODEX_DELEGATION=auto

# Voix naturelle : liste avec « edge-tts --list-voices »
# (ex. fr-FR-RemyMultilingualNeural, fr-FR-VivienneMultilingualNeural, fr-FR-HenriNeural)
JARVIS_VOICE=fr-FR-RemyMultilingualNeural
JARVIS_VOICE_RATE=+5%

# Voix premium ElevenLabs (optionnel) : JARVIS_TTS=elevenlabs + ta clé (elevenlabs.io → API keys).
# Si le quota est épuisé, il repasse tout seul sur la voix gratuite ci-dessus.
JARVIS_TTS=edge
ELEVENLABS_API_KEY=
# Voix : « Daniel » (posée, britannique) par défaut ; choisis-en une sur elevenlabs.io → Voices.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_flash_v2_5

# Conversation : avec une clé OPENAI_API_KEY (ci-dessous), ChatGPT mène la conversation (très rapide)
# et confie à Claude tout ce qui demande d'agir (PC, e-mails, agenda, mémoire, web).
# auto (défaut) = ChatGPT dès qu'une clé est présente ; claude = Claude fait tout.
JARVIS_CONVERSATION=auto
JARVIS_GPT_MODEL=gpt-4.1-mini

# Voix OpenAI (optionnel) : JARVIS_TTS=openai + une clé API (platform.openai.com → API keys).
# Attention : facturée à l'usage sur le compte API, ce n'est PAS inclus dans ChatGPT Plus.
OPENAI_API_KEY=
# Voix : alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse…
OPENAI_VOICE=ash
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Le ton, en langage naturel :
OPENAI_VOICE_INSTRUCTIONS=Parle en français naturel, sur un ton chaleureux et détendu, comme un ami attentionné.

# L'appeler par son nom pendant qu'il parle le coupe et il t'écoute : 1 ou 0
JARVIS_BARGE_IN=1

# Micro et haut-parleurs : vide = ceux par défaut de Windows. Sinon un numéro ou un bout du nom
# (liste : python -m jarvis --micros). Exemples : JARVIS_MIC=Yeti   JARVIS_SPEAKERS=casque
JARVIS_MIC=
JARVIS_SPEAKERS=

# Reconnaissance vocale Whisper : tiny, base, small, medium, large-v3 (plus gros = plus précis mais plus lent).
# Sans carte NVIDIA (ex. carte AMD), « base » est le bon compromis : réponses bien plus rapides.
JARVIS_WHISPER_MODEL=small
# Activation : nom (tu l'appelles par son nom, naturellement) ou hey (dire « Hey Jarvis », seule formule disponible dans ce mode, moins gourmand pour le PC)
JARVIS_WAKE_MODE=nom
# Sensibilité de « Hey Jarvis » en mode hey (0 à 1, plus bas = plus sensible)
JARVIS_WAKE_THRESHOLD=0.5
# Secondes pendant lesquelles il attend une suite sans que tu le rappelles
JARVIS_FOLLOW_UP_SECONDS=6

# Briefing automatique (météo, agenda, mails, tâches) au premier lancement de la matinée : 1 ou 0
JARVIS_DAILY_BRIEFING=1

# Mémoire : minutes d'inactivité avant de résumer la conversation dans la mémoire
JARVIS_IDLE_MINUTES=20

# Rappels de rendez-vous (minutes d'avance, 0 = désactivé) et port du centre de commande
JARVIS_EVENT_REMINDER_MINUTES=10
JARVIS_DASHBOARD_PORT=8765
